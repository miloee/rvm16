+
+def bare_simm4_lsb0 : Operand<OtherVT>,
+                     ImmLeaf<XLenVT, [{return isShiftedInt<3, 1>(Imm);}]> {
+  let ParserMatchClass = BareSImmNLsb0AsmOperand<4>;
+  let PrintMethod = "printBranchOperand";
+  let EncoderMethod = "getImmOpValueAsrN<1>";
+  let DecoderMethod = "decodeSImmOperandAndLslN<4, 1>";
+  let MCOperandPredicate = [{
+    int64_t Imm;
+    if (MCOp.evaluateAsConstantImm(Imm))
+      return isShiftedInt<3, 1>(Imm);
+    return MCOp.isBareSymbolRef();
+  }];
+  let OperandType = "OPERAND_PCREL";
+}
+
+def bare_simm7_lsb0 : Operand<OtherVT>,
+                     ImmLeaf<XLenVT, [{return isShiftedInt<6, 1>(Imm);}]> {
+  let ParserMatchClass = BareSImmNLsb0AsmOperand<7>;
+  let PrintMethod = "printBranchOperand";
+  let EncoderMethod = "getImmOpValueAsrN<1>";
+  let DecoderMethod = "decodeSImmOperandAndLslN<7, 1>";
+  let MCOperandPredicate = [{
+    int64_t Imm;
+    if (MCOp.evaluateAsConstantImm(Imm))
+      return isShiftedInt<6, 1>(Imm);
+    return MCOp.isBareSymbolRef();
+  }];
+  let OperandType = "OPERAND_PCREL";
+}
+//===-- RISCVInstrInfoZvmc.td - RVM16-C test instructions --*- tablegen -*-===//
+//
+// RVM16-C: 16 GPR, quadrant 11 only, distinct mnemonics for MC testing.
+//
+//===----------------------------------------------------------------------===//
+
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvmcALU<bits<4> f4, bits<2> funct2, string op>
+    : RVInst16<(outs GPR4:$rd_wb), (ins GPR4:$rd, GPR4:$rs2),
+               op, "$rd, $rs2", [], InstFormatOther> {
+  bits<4> rd;
+  bits<4> rs2;
+  let Constraints = "$rd = $rd_wb";
+  let Inst{15-12} = f4;
+  let Inst{11-10} = funct2;
+  let Inst{9-6} = rd;
+  let Inst{5-2} = rs2;
+  let Inst{1-0} = 0b11;
+}
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvmcBR<bits<4> f4, string op>
+    : RVInst16<(outs), (ins GPRC:$rs1, GPRC:$rs2, bare_simm4_lsb0:$off),
+               op, "$rs1, $rs2, $off", [], InstFormatZVMCB> {
+  bits<3> rs1;
+  bits<3> rs2;
+  bits<4> off;
+  let Inst{15-12} = f4;
+  let Inst{11-9} = rs1;
+  let Inst{8-6} = rs2;
+  let Inst{5-2} = off;
+  let Inst{1-0} = 0b11;
+  let isBranch = 1;
+  let isTerminator = 1;
+}
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvmcBLEZ<bits<4> f4, string op>
+    : RVInst16<(outs), (ins GPRC:$rs, bare_simm7_lsb0:$off),
+               op, "$rs, $off", [], InstFormatZVMCBZ> {
+  bits<3> rs;
+  bits<7> off;
+  let Inst{15-12} = f4;
+  let Inst{11-9} = rs;
+  let Inst{8-2} = off;
+  let Inst{1-0} = 0b11;
+  let isBranch = 1;
+  let isTerminator = 1;
+}
+
+let hasSideEffects = 0, mayLoad = 0, mayStore = 0 in
+class ZvmcGP<bits<2> funct2, string op>
+    : RVInst16<(outs GPRC:$rd), (ins uimm5:$off),
+               op, "$rd, $off", [], InstFormatOther> {
+  bits<3> rd;
+  bits<5> off;
+  let Inst{15-12} = 0b0011;
+  let Inst{11-10} = funct2;
+  let Inst{9-7} = rd;
+  let Inst{6-2} = off;
+  let Inst{1-0} = 0b11;
+}
+
+let hasSideEffects = 0 in
+class ZvmcLS<bits<2> funct2, string op>
+    : RVInst16<(outs), (ins GPR4:$rd, BaseGPR:$base, uimm2:$off),
+               op, "$rd, $off, $base", [], InstFormatOther> {
+  bits<4> rd;
+  bits<2> base;
+  bits<2> off;
+  let Inst{15-12} = 0b1000;
+  let Inst{11-10} = funct2;
+  let Inst{9-6} = rd;
+  let Inst{5-4} = base;
+  let Inst{3-2} = off;
+  let Inst{1-0} = 0b11;
+}
+
+let Predicates = [HasStdExtZc16q3] in {
+def ZVMC_ADD  : ZvmcALU<0, 0, "c.addc">;
+def ZVMC_SUB  : ZvmcALU<0, 1, "c.subc">;
+def ZVMC_AND  : ZvmcALU<0, 2, "c.andc">;
+def ZVMC_OR   : ZvmcALU<0, 3, "c.orc">;
+def ZVMC_XOR  : ZvmcALU<1, 0, "c.xorc">;
+def ZVMC_SLL  : ZvmcALU<1, 1, "c.sllc">;
+def ZVMC_SRL  : ZvmcALU<1, 2, "c.srlc">;
+def ZVMC_SRA  : ZvmcALU<1, 3, "c.srac">;
+def ZVMC_SLT  : ZvmcALU<2, 0, "c.sltc">;
+def ZVMC_SLTU : ZvmcALU<2, 1, "c.sltuc">;
+
+def ZVMC_BNE  : ZvmcBR<0b0101, "c.bnec">;
+def ZVMC_BLT  : ZvmcBR<0b0110, "c.bltc">;
+def ZVMC_BLEZ : ZvmcBLEZ<0b0111, "c.blezc">;
+
+def ZVMC_LWGP : ZvmcGP<0, "c.lwgc">;
+def ZVMC_SWGP : ZvmcGP<1, "c.swgc">;
+def ZVMC_LWPC : ZvmcGP<2, "c.lwpc">;
+
+def ZVMC_LW   : ZvmcLS<0, "c.lwc"> { let mayLoad = 1; let mayStore = 0; }
+def ZVMC_SW   : ZvmcLS<1, "c.swc"> { let mayLoad = 0; let mayStore = 1; }
+}

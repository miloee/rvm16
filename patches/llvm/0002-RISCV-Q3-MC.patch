+static DecodeStatus decodeQ3(MCInst &MI, uint16_t Insn, uint64_t Address,
+                             const MCDisassembler *Decoder) {
+  unsigned f4 = (Insn >> 12) & 0xF;
+  auto R = [](unsigned N) { return MCOperand::createReg(N); };
+  auto F = [](unsigned N) { return MCOperand::createReg(N); };
+  auto I = [](unsigned N) { return MCOperand::createImm(N); };
+
+  switch (f4) {
+  case 0:
+    MI.setOpcode(RISCV::Q3_SLL);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 31)));
+    return MCDisassembler::Success;
+  case 1:
+    MI.setOpcode(RISCV::Q3_SRL);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 31)));
+    return MCDisassembler::Success;
+  case 2:
+    MI.setOpcode(RISCV::Q3_SRA);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 31)));
+    return MCDisassembler::Success;
+  case 3:
+    MI.setOpcode(RISCV::Q3_SLT);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 31)));
+    return MCDisassembler::Success;
+  case 4:
+    MI.setOpcode(RISCV::Q3_SLTU);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 7) & 31)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 31)));
+    return MCDisassembler::Success;
+  case 6:
+    if (((Insn >> 10) & 3) != 3)
+      return MCDisassembler::Fail;
+    MI.setOpcode(RISCV::Q3_XORI);
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 6) & 0xF)));
+    MI.addOperand(R(RISCV::X0 + ((Insn >> 6) & 0xF)));
+    MI.addOperand(I((Insn >> 2) & 0xF));
+    return MCDisassembler::Success;
+  case 7:
+    if (((Insn >> 10) & 3) != 2)
+      return MCDisassembler::Fail;
+    {
+      static const unsigned Bases[4] = {RISCV::X8, RISCV::X9, RISCV::X2,
+                                        RISCV::X3};
+      MI.setOpcode(RISCV::Q3_LW);
+      MI.addOperand(R(RISCV::X8 + ((Insn >> 7) & 7)));
+      MI.addOperand(R(Bases[(Insn >> 5) & 3]));
+      MI.addOperand(I((Insn >> 2) & 7));
+    }
+    return MCDisassembler::Success;
+  case 8:
+    if (((Insn >> 10) & 3) != 3)
+      return MCDisassembler::Fail;
+    {
+      static const unsigned Bases[4] = {RISCV::X8, RISCV::X9, RISCV::X2,
+                                        RISCV::X3};
+      MI.setOpcode(RISCV::Q3_SW);
+      MI.addOperand(R(RISCV::X8 + ((Insn >> 7) & 7)));
+      MI.addOperand(R(Bases[(Insn >> 5) & 3]));
+      MI.addOperand(I((Insn >> 2) & 7));
+    }
+    return MCDisassembler::Success;
+  case 5: {
+    unsigned funct3 = (Insn >> 9) & 7;
+    unsigned rd = 8 + ((Insn >> 6) & 7);
+    unsigned rs2 = 8 + ((Insn >> 3) & 7);
+    unsigned Op;
+    switch (funct3) {
+    case 1: Op = RISCV::C_MULH_Q3; break;
+    case 2: Op = RISCV::C_MULHSU_Q3; break;
+    case 3: Op = RISCV::C_MULHU_Q3; break;
+    case 4: Op = RISCV::C_DIV_Q3; break;
+    case 5: Op = RISCV::C_DIVU_Q3; break;
+    case 6: Op = RISCV::C_REM_Q3; break;
+    case 7: Op = RISCV::C_REMU_Q3; break;
+    default: return MCDisassembler::Fail;
+    }
+    MI.setOpcode(Op);
+    MI.addOperand(R(RISCV::X0 + rd));
+    MI.addOperand(R(RISCV::X0 + rd));
+    MI.addOperand(R(RISCV::X0 + rs2));
+    return MCDisassembler::Success;
+  }
+  case 9:
+  case 10:
+  case 11:
+  case 12: {
+    unsigned funct2 = (Insn >> 10) & 3;
+    unsigned fd = (Insn >> 6) & 0xF;
+    unsigned fs2 = (Insn >> 2) & 0xF;
+    if (f4 == 11 && funct2 >= 2) {
+      MI.setOpcode(funct2 == 2 ? RISCV::C_FEQ_S : RISCV::C_FLT_S);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fs2));
+    } else if (f4 == 12 && funct2 == 0) {
+      MI.setOpcode(RISCV::C_FLE_S);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fs2));
+    } else if (f4 == 12 && funct2 == 1) {
+      MI.setOpcode(RISCV::C_FCVT_S_W);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(R(RISCV::X0 + fs2));
+    } else if (f4 == 12 && funct2 >= 2) {
+      MI.setOpcode(funct2 == 2 ? RISCV::C_FCVT_W_S : RISCV::C_FCLASS_S);
+      MI.addOperand(R(RISCV::X0 + fs2));
+      MI.addOperand(F(RISCV::F0_F + fd));
+    } else {
+      unsigned Op;
+      switch (f4) {
+      case 9:
+        Op = funct2 == 0 ? RISCV::C_FADD_S :
+             funct2 == 1 ? RISCV::C_FSUB_S :
+             funct2 == 2 ? RISCV::C_FMUL_S : RISCV::C_FDIV_S;
+        break;
+      case 10:
+        Op = funct2 == 0 ? RISCV::C_FSQRT_S :
+             funct2 == 1 ? RISCV::C_FMIN_S :
+             funct2 == 2 ? RISCV::C_FMAX_S : RISCV::C_FSGNJ_S;
+        break;
+      case 11:
+        Op = funct2 == 0 ? RISCV::C_FSGNJN_S : RISCV::C_FSGNJX_S;
+        break;
+      default:
+        return MCDisassembler::Fail;
+      }
+      MI.setOpcode(Op);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fs2));
+    }
+    return MCDisassembler::Success;
+  }
+  case 13: {
+    unsigned funct2 = (Insn >> 10) & 3;
+    unsigned fd = (Insn >> 6) & 0xF;
+    if (funct2 == 0) {
+      MI.setOpcode(RISCV::C_FMV_X_W);
+      MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 0xF)));
+      MI.addOperand(F(RISCV::F0_F + fd));
+    } else if (funct2 == 1) {
+      MI.setOpcode(RISCV::C_FMV_W_X);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(R(RISCV::X0 + ((Insn >> 2) & 0xF)));
+    } else {
+      static const unsigned Bases[4] = {RISCV::X8, RISCV::X9, RISCV::X2,
+                                        RISCV::X3};
+      MI.setOpcode(funct2 == 2 ? RISCV::C_FLW_Q3 : RISCV::C_FSW_Q3);
+      MI.addOperand(F(RISCV::F0_F + fd));
+      MI.addOperand(R(Bases[(Insn >> 4) & 3]));
+      MI.addOperand(I((Insn >> 2) & 3));
+    }
+    return MCDisassembler::Success;
+  }
+  case 14: {
+    unsigned op2 = (Insn >> 2) & 3;
+    unsigned csr = (Insn >> 8) & 0xF;
+    unsigned reg = (Insn >> 4) & 0xF;
+    if (op2 == 0) {
+      MI.setOpcode(RISCV::C_CSRR_Q3);
+      MI.addOperand(R(RISCV::X0 + reg));
+      MI.addOperand(I(csr));
+    } else {
+      MI.setOpcode(op2 == 1 ? RISCV::C_CSRW_Q3 :
+                    op2 == 2 ? RISCV::C_CSRS_Q3 : RISCV::C_CSRC_Q3);
+      MI.addOperand(I(csr));
+      MI.addOperand(R(RISCV::X0 + reg));
+    }
+    return MCDisassembler::Success;
+  }
+  case 15: {
+    unsigned imm = (Insn >> 2) & 0x3FF;
+    unsigned Op;
+    switch (imm) {
+    case 0: Op = RISCV::C_ECALL_Q3; break;
+    case 2: Op = RISCV::C_MRET_Q3; break;
+    case 3: Op = RISCV::C_WFI_Q3; break;
+    case 4: Op = RISCV::C_FENCE_Q3; break;
+    case 5: Op = RISCV::C_FENCE_I_Q3; break;
+    default: return MCDisassembler::Fail;
+    }
+    MI.setOpcode(Op);
+    return MCDisassembler::Success;
+  }
+  default:
+    return MCDisassembler::Fail;
+  }
+}
+
 DecodeStatus RISCVDisassembler::getInstruction(MCInst &MI, uint64_t &Size,
                                                ArrayRef<uint8_t> Bytes,
                                                uint64_t Address,
@@ -684,6 +892,17 @@ DecodeStatus RISCVDisassembler::getInstruction(MCInst &MI, uint64_t &Size,
   if ((Bytes[0] & 0b11) == 0b00 || (Bytes[0] & 0b11) == 0b01)
     return getInstruction16(MI, Size, Bytes, Address, CS);
 
+  // RVA-E16 Q3: bits[1:0] = 11 but the instruction is 16 bits.
+  if ((Bytes[0] & 0b11) == 0b11 &&
+      STI.hasFeature(RISCV::FeatureStdExtZc16q3) && Bytes.size() >= 2) {
+    uint16_t Insn16 = Bytes[0] | (Bytes[1] << 8);
+    DecodeStatus Q3 = decodeQ3(MI, Insn16, Address, this);
+    if (Q3 != MCDisassembler::Fail) {
+      Size = 2;
+      return Q3;
+    }
+  }
+
   // Try to decode as a 32-bit instruction first.
   DecodeStatus Result = getInstruction32(MI, Size, Bytes, Address, CS);
   if (Result != MCDisassembler::Fail)

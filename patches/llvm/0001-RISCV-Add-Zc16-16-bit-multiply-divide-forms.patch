+// Zc16: 16-bit forms for integer multiply/divide operations that are not
+// already covered by Zcb's c.mul.  The encoding reuses the C.FLD slot, so
+// Zc16 requires that the D extension is not implemented.
+def FeatureStdExtZc16
+    : RISCVExtension<1, 0,
+                     "16-bit integer multiply/divide forms">;
+def HasStdExtZc16 : Predicate<"Subtarget->hasStdExtZc16()">,
+                    AssemblerPredicate<(all_of FeatureStdExtZc16),
+                        "'Zc16' (16-bit integer multiply/divide forms)">;
+
 // Bitmanip Extensions
 
 def FeatureStdExtZba

--- /dev/null
+++ b/riscv/insns/c_mulh.h
@@ -0,0 +1,8 @@
+require_extension(EXT_ZC16);
+require_either_extension('M', EXT_ZMMUL);
+reg_t rd = insn.cm_rd();
+reg_t rs2 = insn.cm_rs2();
+if (xlen == 64)
+  WRITE_REG(rd, mulh(READ_REG(rd), READ_REG(rs2)));
+else
+  WRITE_REG(rd, sext32((sext32(READ_REG(rd)) * sext32(READ_REG(rs2))) >> 32));

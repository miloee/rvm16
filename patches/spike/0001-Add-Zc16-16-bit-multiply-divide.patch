--- /dev/null
+++ b/riscv/insns/c_div.h
@@ -0,0 +1,10 @@
+require_extension(EXT_ZC16);
+require_either_extension('M', EXT_ZMMUL);
+sreg_t lhs = sext_xlen(READ_REG(insn.cm_rd()));
+sreg_t rhs = sext_xlen(READ_REG(insn.cm_rs2()));
+if (rhs == 0)
+  WRITE_REG(insn.cm_rd(), UINT64_MAX);
+else if (lhs == INT64_MIN && rhs == -1)
+  WRITE_REG(insn.cm_rd(), lhs);
+else
+  WRITE_REG(insn.cm_rd(), sext_xlen(lhs / rhs));
